.text		; comparação 1
    mov a, [v0]	; recebe o valor de 80H
    mov b, [v1]	; recebe o valor de 81H
    cmp a, b	; calcula a-b
    js  p1	; se já está em ordem ele pula pra próxima instrução
    db  0xC0	; swap a, b
    mov [v0], a	; grava na memoria o valor de a
    mov [v1], b	; grava na memoria o valor de b
p1:		; comparação 2	
    mov a, [v1]	; recebe o valor de 81H
    mov b, [v2]	; recebe o valor de 82H
    cmp a, b	; calcula a-b
    js  p2	; se já está em ordem ele pula pra próxima instrução
    db  0xC0	; swap a, b
    mov [v1], a	; grava na memoria o valor de a
    mov [v2], b	; grava na memoria o valor de b
p2:		; comparação 3
    mov a, [v0]	; recebe o valor de 80H
    mov b, [v1] ; recebe o valor de 81H
    cmp a, b	; calcula a-b	
    js  p3	; se já está em ordem ele pula pro fim
    db  0xC0	; swap a, b
    mov [v0], a	; grava na memoria o valor de a
    mov [v1], b	; grava na memoria o valor de b
p3:
    hlt		; termina o programa

.data
org 0x80
v0: db 16	; valor 1 no endereço 80H
org 0x81
v1: db 4	; valor 2 no endereço 81H
org 0x82
v2: db 8	; valor 3 no endereço 82H