.text
    mov a, [v0]
    mov b, [v1]
    cmp a, b
    js  p1
    db  0xC0
    mov [v0], a
    mov [v1], b
p1:
    mov a, [v1]
    mov b, [v2]
    cmp a, b
    js  p2
    db  0xC0
    mov [v1], a
    mov [v2], b
p2:
    mov a, [v0]
    mov b, [v1]
    cmp a, b
    js  p3
    db  0xC0
    mov [v0], a
    mov [v1], b
p3:
    hlt

.data
org 0x80
v0: db 16
org 0x81
v1: db 8
org 0x82
v2: db 4